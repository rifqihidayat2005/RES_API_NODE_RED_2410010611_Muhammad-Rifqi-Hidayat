    "z": "16be0f85768927a6",
    "name": "Simpan Data Sensor",
    "func": "var data = msg.payload;\n\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); }\n    catch(e) { return null; }\n}\n\nif (!data || typeof data !== 'object') return null;\n\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nreturn {payload: data};",
