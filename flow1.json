  {
    "id": "4453986bb7a2aefb",
    "type": "template",
    "z": "16be0f85768927a6",
    "name": "Dashboard Chart.js",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Monitoring ESP32</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<style>\n*{box-sizing:border-box}body{font-family:Arial,sans-serif;background:#eef2ff;margin:0;padding:20px;color:#1f2937}\n.container{max-width:1050px;margin:auto}.panel{background:#fff;border-radius:12px;padding:20px;margin:0 0 18px;box-shadow:0 4px 16px rgba(0,0,0,.08)}\nh1{text-align:center;color:#fff;margin:5px 0 22px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:18px}\n.card{background:#fff;border-radius:12px;padding:18px;text-align:center;box-shadow:0 4px 16px rgba(0,0,0,.08)}.label{color:#6b7280;font-size:13px}.value{font-size:32px;font-weight:bold;margin-top:8px;color:#4f46e5}\n#status{padding:11px;border-radius:8px;text-align:center;background:#e5e7eb;margin-bottom:16px;font-weight:bold}#warning{padding:13px;border-radius:8px;background:#dcfce7;color:#166534}\nbutton{border:0;border-radius:8px;padding:10px 15px;background:#4f46e5;color:#fff;font-weight:bold;cursor:pointer;margin:0 0 12px}button:hover{opacity:.9}\n.chart{height:300px;position:relative}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}th{background:#f3f4f6;color:#4b5563}\n.bad{color:#b91c1c;font-weight:bold}.good{color:#15803d;font-weight:bold}.muted{color:#6b7280;text-align:center}\n@media(max-width:600px){body{padding:10px}.panel{padding:14px}.chart{height:250px}table{font-size:12px}}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h1>MONITORING SENSOR ESP32</h1>\n<div id=\"status\">Menghubungkan WebSocket...</div>\n<div class=\"cards\">\n  <div class=\"card\"><div class=\"label\">SUHU</div><div class=\"value\"><span id=\"suhu\">--</span> °C</div></div>\n  <div class=\"card\"><div class=\"label\">KELEMBABAN</div><div class=\"value\"><span id=\"kelembaban\">--</span> %</div></div>\n  <div class=\"card\"><div class=\"label\">BATAS SUHU</div><div class=\"value\"><span id=\"batas\">35</span> °C</div></div>\n</div>\n<div class=\"panel\">\n  <h3>Peringatan Sensor</h3>\n  <div id=\"warning\">Sensor dalam kondisi NORMAL</div>\n  <p><button id=\"enableNotifications\">Aktifkan Notifikasi Browser</button></p>\n</div>\n<div class=\"panel\"><h3>Grafik Real-Time Sensor</h3><div class=\"chart\"><canvas id=\"sensorChart\"></canvas></div></div>\n<div class=\"panel\">\n  <h3>10 Data Sensor Terakhir</h3>\n  <table><thead><tr><th>Waktu</th><th>Suhu (°C)</th><th>Kelembaban (%)</th><th>Status</th></tr></thead>\n  <tbody id=\"history-body\"><tr><td colspan=\"4\" class=\"muted\">Memuat riwayat...</td></tr></tbody></table>\n</div>\n</div>\n<script>\nconst API_KEY = 'KULIAH-API-2026';\nconst historyBody = document.getElementById('history-body');\nlet historyRows = [];\nlet wasWarning = false;\nconst chart = new Chart(document.getElementById('sensorChart'), {\n  type: 'line',\n  data: {labels: [], datasets: [\n    {label:'Suhu (°C)', data:[], borderColor:'#dc2626', tension:.3},\n    {label:'Kelembaban (%)', data:[], borderColor:'#2563eb', tension:.3}\n  ]},\n  options: {responsive:true, maintainAspectRatio:false, animation:false, scales:{y:{beginAtZero:true}}}\n});\nfunction waktuTampil(value) {\n  if (!value) return '--';\n  const d = new Date(value);\n  return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('id-ID');\n}\nfunction statusRow(d) {\n  const lim = Number(d.threshold ?? document.getElementById('batas').textContent);\n  return Number(d.suhu) > lim ? 'WARNING' : 'NORMAL';\n}\nfunction renderHistory() {\n  historyBody.innerHTML = '';\n  if (!historyRows.length) {\n    const tr = historyBody.insertRow(); const td = tr.insertCell(); td.colSpan=4; td.className='muted'; td.textContent='Belum ada data sensor'; return;\n  }\n  historyRows.slice(0,10).forEach(d => {\n    const tr = historyBody.insertRow();\n    const values = [waktuTampil(d.waktu || d.received), d.suhu ?? '--', d.kelembaban ?? '--'];\n    values.forEach(v => { const td=tr.insertCell(); td.textContent=v; });\n    const td=tr.insertCell(); const status=statusRow(d); td.textContent=status; td.className=status==='WARNING'?'bad':'good';\n  });\n}\nasync function loadHistory() {\n  try {\n    const res = await fetch('/api/history', {headers:{'X-API-Key':API_KEY}});\n    if (!res.ok) throw new Error('HTTP '+res.status);\n    const result = await res.json();\n    historyRows = Array.isArray(result.data) ? result.data.slice(0,10) : [];\n    renderHistory();\n  } catch (err) {\n    historyBody.innerHTML=''; const tr=historyBody.insertRow(); const td=tr.insertCell(); td.colSpan=4; td.className='bad'; td.textContent='Gagal memuat history: '+err.message;\n  }\n}\nfunction prependHistory(d) {\n  historyRows.unshift(d);\n  historyRows = historyRows.slice(0,10);\n  renderHistory();\n}\ndocument.getElementById('enableNotifications').addEventListener('click', async () => {\n  if (!('Notification' in window)) { alert('Browser ini tidak mendukung notifikasi.'); return; }\n  const permission = await Notification.requestPermission();\n  document.getElementById('enableNotifications').textContent = permission === 'granted' ? 'Notifikasi Aktif' : 'Izin Notifikasi Belum Diberikan';\n});\nfunction connectWebSocket() {\n  const scheme = location.protocol === 'https:' ? 'wss://' : 'ws://';\n  const ws = new WebSocket(scheme + location.host + '/ws/sensor');\n  ws.onopen = () => { document.getElementById('status').textContent='ONLINE'; };\n  ws.onclose = () => { document.getElementById('status').textContent='WEBSOCKET TERPUTUS — mencoba menghubungkan kembali'; setTimeout(connectWebSocket,3000); };\n  ws.onerror = () => { document.getElementById('status').textContent='Koneksi WebSocket bermasalah'; };\n  ws.onmessage = (event) => {\n    try {\n      const d = JSON.parse(event.data);\n      document.getElementById('suhu').textContent = d.suhu ?? '--';\n      document.getElementById('kelembaban').textContent = d.kelembaban ?? '--';\n      document.getElementById('batas').textContent = d.threshold ?? 35;\n      const time = new Date(d.waktu || Date.now()).toLocaleTimeString();\n      chart.data.labels.push(time); chart.data.datasets[0].data.push(d.suhu); chart.data.datasets[1].data.push(d.kelembaban);\n      if (chart.data.labels.length > 20) { chart.data.labels.shift(); chart.data.datasets.forEach(s => s.data.shift()); }\n      chart.update('none');\n      const warning = d.status === 'warning';\n      const box = document.getElementById('warning');\n      box.textContent = warning ? `PERINGATAN: Suhu ${d.suhu} °C melewati batas ${d.threshold} °C` : 'Sensor dalam kondisi NORMAL';\n      box.style.background = warning ? '#fee2e2' : '#dcfce7'; box.style.color = warning ? '#991b1b' : '#166534';\n      if (warning && !wasWarning && 'Notification' in window && Notification.permission === 'granted') {\n        new Notification('PERINGATAN SUHU ESP32', {body:`Suhu ${d.suhu} °C melewati batas ${d.threshold} °C`});\n      }\n      wasWarning = warning;\n      prependHistory(d);\n      document.getElementById('status').textContent = warning ? 'ONLINE — SUHU MELEWATI BATAS' : 'ONLINE — Sensor Normal';\n    } catch (err) { console.error('Data WebSocket tidak valid:', err); }\n  };\n}\nloadHistory().finally(connectWebSocket);\n</script>\n</body>\n</html>",
