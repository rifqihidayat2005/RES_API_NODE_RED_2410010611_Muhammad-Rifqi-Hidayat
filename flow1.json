  {
    "id": "728343bca85229fe",
    "type": "function",
    "z": "16be0f85768927a6",
    "name": "Proses Sensor SQLite WebSocket Threshold",
    "func": "var data = msg.payload;\nvar suhu = Number(data.suhu);\nvar kelembaban = Number(data.kelembaban);\n\nif (!Number.isFinite(suhu)) return null;\nif (!Number.isFinite(kelembaban)) kelembaban = null;\n\nvar waktu = data.received || new Date().toISOString();\nvar batas = Number(flow.get('thresholdSuhu') || 35);\nvar isWarning = suhu > batas;\nvar wasWarning = flow.get('isSuhuWarning') === true;\n\n// Output 1: simpan setiap pembacaan ke SQLite\nvar dbMsg = {\n    topic: 'INSERT INTO sensor_history (suhu, kelembaban, waktu, data_json) VALUES ($suhu, $kelembaban, $waktu, $data_json)',\n    payload: [suhu, kelembaban, waktu, JSON.stringify(data)]\n};\n\n// Output 2: kirim pembacaan ke dashboard melalui WebSocket\nvar wsMsg = {\n    payload: JSON.stringify({\n        suhu: suhu,\n        kelembaban: kelembaban,\n        waktu: waktu,\n        threshold: batas,\n        status: isWarning ? 'warning' : 'normal'\n    })\n};\n\n// Output 3: kirim satu notifikasi MQTT saat baru melewati batas\nvar notifMsg = null;\nif (isWarning && !wasWarning) {\n    notifMsg = {\n        topic: 'iot/notifikasi',\n        payload: JSON.stringify({\n            status: 'warning',\n            message: 'PERINGATAN! Suhu melewati batas!',\n            suhu: suhu,\n            batas_suhu: batas,\n            waktu: waktu\n        })\n    };\n}\nflow.set('isSuhuWarning', isWarning);\n\nreturn [dbMsg, wsMsg, notifMsg];",
    "outputs": 3,
